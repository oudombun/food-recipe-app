<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/labelInput"
            android:text="Email"
            style="@style/FontInputLabel"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/rightLabel"
            android:text="Change Password"
            style="@style/FontActionClick"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_width="wrap_content"
            android:layout_centerVertical="true"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@drawable/input_round_bg"
        android:paddingHorizontal="16dp"
        android:layout_height="44dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/startIconView"
                android:src="@drawable/ic_toggle_password"
                android:visibility="gone"
                android:layout_marginRight="8dp"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <EditText
                android:id="@+id/inputText"
                style="@style/FontNormal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:hint="Email"
                android:background="@android:color/transparent"/>

            <TextView
                android:id="@+id/stringText"
                style="@style/FontNormal"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:hint="Email"
                android:background="@android:color/transparent"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/rightIcon"
            android:src="@drawable/ic_show_password"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:adjustViewBounds="true"
            android:layout_margin="8dp"
            android:scaleType="fitXY"
            android:visibility="gone"
            android:layout_width="22dp"
            android:layout_height="22dp" />

    </RelativeLayout>

</LinearLayout>