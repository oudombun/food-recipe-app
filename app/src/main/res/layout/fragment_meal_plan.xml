<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="mainViewModel"
            type="com.oudombun.chelfy.viewmodel.MainViewModel" />
        <variable
            name="mealPlan"
            type="com.oudombun.chelfy.models.MealPlanResponse" />

    </data>

    <LinearLayout
        android:background="@drawable/ic_food_joke_background_dark"
        android:orientation="vertical"
        android:padding="@dimen/margin_3x"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_3x"
            android:fontFamily="@font/aclonica"
            android:text="Generate Your Meal Plan"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <Spinner
                android:padding="@dimen/margin_2x"
                android:background="@drawable/bg_dropdown"
                android:id="@+id/diet_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/diet_options" />

            <EditText
                android:layout_marginTop="@dimen/margin_3x"
                android:background="@drawable/bg_fill_white_small_radius"
                android:padding="@dimen/margin_2x"
                android:id="@+id/calories_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Calories (optional)"
                android:inputType="number" />
            <Button
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/margin_3x"
                android:id="@+id/generate_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generate" />

        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            readApiResponse3="@{mainViewModel.mealPlanResponse}"
            readDatabase3="@{mainViewModel.readMealPlan}"
            android:id="@+id/layoutMeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:fontFamily="@font/aclonica"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:id="@+id/mealPlanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Meal Plan" />
            <TextView
                setCalories="@{mealPlan.nutrients.calories}"
                android:textColor="@color/white"
                android:id="@+id/totalCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />

            <TextView
                setProtein="@{mealPlan.nutrients.protein}"
                android:textColor="@color/white"
                android:id="@+id/totalProtein"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/row_breakfast"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="@dimen/margin_2x"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/strokeColor"
                app:strokeWidth="1dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/cardBackgroundColor">

                    <ImageView

                        android:id="@+id/recipe_imageView"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/breakfast" />


                    <TextView
                        android:id="@+id/title_textView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/courgette"
                        android:maxLines="2"
                        android:text="@{mealPlan.meals.get(0).title}"
                        android:textColor="@color/titleColor"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/recipe_imageView"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:text=""
                        android:id="@+id/description_textView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/descriptionColor"
                        app:layout_constraintEnd_toEndOf="@+id/title_textView"
                        app:layout_constraintStart_toStartOf="@+id/title_textView"
                        app:layout_constraintTop_toBottomOf="@+id/title_textView" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/row_lunch"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="@dimen/margin_2x"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/strokeColor"
                app:strokeWidth="1dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/cardBackgroundColor">

                    <ImageView
                        android:id="@+id/recipe_imageView2"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/lunch" />

                    <TextView
                        android:id="@+id/title_textView2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/courgette"
                        android:maxLines="2"
                        android:text="@{mealPlan.meals.get(1).title}"
                        android:textColor="@color/titleColor"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/recipe_imageView2"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:text=""
                        android:id="@+id/description_textView2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/descriptionColor"
                        app:layout_constraintEnd_toEndOf="@+id/title_textView2"
                        app:layout_constraintStart_toStartOf="@+id/title_textView2"
                        app:layout_constraintTop_toBottomOf="@+id/title_textView2" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/row_dinner"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:cardCornerRadius="10dp"
                android:layout_marginTop="@dimen/margin_2x"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/strokeColor"
                app:strokeWidth="1dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@color/cardBackgroundColor">

                    <ImageView
                        android:id="@+id/recipe_imageView3"
                        android:layout_width="150dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/dinner" />

                    <TextView
                        android:id="@+id/title_textView3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/courgette"
                        android:maxLines="2"
                        android:text="@{mealPlan.meals.get(2).title}"
                        android:textColor="@color/titleColor"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/recipe_imageView3"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:text=""
                        android:id="@+id/description_textView3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/descriptionColor"
                        app:layout_constraintEnd_toEndOf="@+id/title_textView3"
                        app:layout_constraintStart_toStartOf="@+id/title_textView3"
                        app:layout_constraintTop_toBottomOf="@+id/title_textView3" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        <ProgressBar
            android:visibility="gone"
            readApiResponse3="@{mainViewModel.mealPlanResponse}"
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</layout>
