<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="result"
            type="com.oudombun.chelfy.core.model.ResultData" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_2x"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/strokeColor"
        app:cardElevation="3dp"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootResult"
            android:layout_width="150dp"
            onRecipeClickListener="@{result}"
            android:layout_height="200dp"
            android:clickable="false"
            android:focusable="false"
            android:orientation="vertical"
            android:padding="@dimen/padding_3x">

<!--            <de.hdodenhof.circleimageview.CircleImageView-->
<!--                android:id="@+id/imageView"-->
<!--                loadImageCircleFromUrl="@{result.image}"-->
<!--                app:layout_constraintEnd_toEndOf="parent"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                android:layout_width="100dp"-->
<!--                android:layout_height="100dp"-->
<!--                app:civ_border_width="0dp"-->
<!--                app:civ_border_color="#CCC5C5" />-->
            <androidx.cardview.widget.CardView
                android:id="@+id/roundCardView"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:elevation="0dp"
                app:cardCornerRadius="200dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/favorite_recipe_imageView"
                    loadImageFromUrl="@{result.image}"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"

                    tools:srcCompat="@tools:sample/avatars" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_marginTop="@dimen/margin_2x"
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:ellipsize="end"
                android:fontFamily="@font/courgette"
                android:maxLines="1"
                android:text="@{result.title}"
                android:textColor="@color/titleColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/roundCardView" />

            <TextView
                android:textSize="@dimen/text_small"
                android:textColor="@color/descriptionColor"
                android:id="@+id/calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250 Kcal"
                parseCalories="@{result.summary}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/clock_textView"
                setTextOfMinutes="@{result.readyInMinutes}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textSize="12sp"
                android:textAlignment="center"
                android:textColor="@color/yellow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>