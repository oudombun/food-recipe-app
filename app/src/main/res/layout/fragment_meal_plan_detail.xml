<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:background="@drawable/ic_food_joke_background_dark"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_margin="@dimen/margin_4x"
        android:id="@+id/top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">
        <ImageView
            android:id="@+id/toolbarBackResult"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:layout_marginEnd="@dimen/margin_3x"
            android:src="@drawable/baseline_arrow_back_ios_new_24_white" />
        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:fontFamily="@font/aclonica"
            android:text="Meal Plan"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/instructions_webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_layout" />

</RelativeLayout>