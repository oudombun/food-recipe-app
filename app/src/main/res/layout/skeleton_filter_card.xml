<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_2x"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/strokeColor"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:padding="@dimen/padding_3x">

        <!-- Circular image placeholder -->
        <View
            android:id="@+id/skeleton_circle"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/ddd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title placeholder -->
        <View
            android:id="@+id/skeleton_title"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="@dimen/margin_2x"
            android:background="#E0E0E0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_circle" />

        <!-- Calories placeholder -->
        <View
            android:id="@+id/skeleton_calories"
            android:layout_width="60dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_title" />

        <!-- Time placeholder -->
        <View
            android:id="@+id/skeleton_time"
            android:layout_width="40dp"
            android:layout_height="12dp"
            android:background="#E0E0E0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/skeleton_calories" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

