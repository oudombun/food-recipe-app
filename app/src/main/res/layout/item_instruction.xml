<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <LinearLayout
        android:layout_marginTop="@dimen/margin_5x"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:background="@drawable/bg_step_raius"
            android:text="Step 1"
            android:paddingTop="@dimen/margin_1x"
            android:paddingBottom="@dimen/margin_1x"
            android:paddingStart="@dimen/margin_3x"
            android:paddingEnd="@dimen/margin_3x"
            android:id="@+id/step_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/margin_3x"/>

        <TextView
            android:text="Instruction"
            android:textColor="@color/black"
            android:id="@+id/instruction_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

        </LinearLayout>

    </LinearLayout>
</layout>