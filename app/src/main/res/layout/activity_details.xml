<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scrolviewdetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/detailsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            app:layoutDescription="@xml/fragment_overview_scene"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/margin_10x">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/actionBarSize"
                    android:background="@color/colorPrimary"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:layout_marginTop="@dimen/margin_5x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:text="Asparagus"
                    android:textColor="@color/titleColor"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/toolbard" />

                <TextView
                    android:id="@+id/text_des"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:layout_marginTop="@dimen/margin_2x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:lineSpacingExtra="4dp"
                    android:text="This recipe is perfect for a satisfying meal! Get ready for a Enjoy a delicious and nourishing meal with this recipe! It offers a Looking for a budget-friendly and convenient meal? Try this recipe! It's a Discover a healthy and flavorful dish with this recipe! It boasts a"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/title_text" />

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/nutrition_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_3x"
                    app:layout_constraintTop_toBottomOf="@+id/text_des">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="20dp" />

                        <LinearLayout
                            android:id="@+id/ll_mainView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/white"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@android:color/white"
                                android:orientation="vertical"
                                android:padding="15dp">

                                <TextView
                                    android:id="@+id/nutrition_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="@dimen/margin_2x"
                                    android:text="Nutritions"
                                    android:textAppearance="@style/TextAppearance.AppCompat.Title"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_fill_gray_small_radius"
                                    android:orientation="horizontal"
                                    android:paddingStart="@dimen/margin_3x"
                                    android:paddingTop="@dimen/margin_2x"
                                    android:paddingEnd="@dimen/margin_3x"
                                    android:paddingBottom="@dimen/margin_2x">

                                    <TextView
                                        android:id="@+id/calories_txt"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:background="@drawable/bg_round_white_raius"
                                        android:gravity="center"
                                        android:padding="@dimen/margin_2x"
                                        android:text="110"
                                        android:textColor="@color/white"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="@dimen/margin_2x"
                                        android:text="Calories"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/margin_3x"
                                    android:background="@drawable/bg_fill_gray_small_radius"
                                    android:orientation="horizontal"
                                    android:paddingStart="@dimen/margin_3x"
                                    android:paddingTop="@dimen/margin_2x"
                                    android:paddingEnd="@dimen/margin_3x"
                                    android:paddingBottom="@dimen/margin_2x">

                                    <TextView
                                        android:id="@+id/protein_txt"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:background="@drawable/bg_round_white_raius"
                                        android:gravity="center"
                                        android:padding="@dimen/margin_2x"
                                        android:text="110"
                                        android:textColor="@color/white"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="@dimen/margin_2x"
                                        android:text="Protein"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="130dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/margin_3x"
                                    android:background="@drawable/bg_fill_gray_small_radius"
                                    android:orientation="horizontal"
                                    android:paddingStart="@dimen/margin_3x"
                                    android:paddingTop="@dimen/margin_2x"
                                    android:paddingEnd="@dimen/margin_3x"
                                    android:paddingBottom="@dimen/margin_2x">

                                    <TextView
                                        android:id="@+id/fat_txt"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:background="@drawable/bg_round_white_raius"
                                        android:gravity="center"
                                        android:padding="@dimen/margin_2x"
                                        android:text="110"
                                        android:textColor="@color/white"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginStart="@dimen/margin_2x"
                                        android:text="Fat"
                                        android:textSize="12sp" />
                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="20dp" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/roundCardView"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_marginEnd="-40dp"
                        android:elevation="5dp"
                        app:cardCornerRadius="200dp"
                        app:cardElevation="10dp"
                        app:layout_anchor="@id/ll_mainView"
                        app:layout_anchorGravity="center|end">

                        <ImageView
                            android:id="@+id/main_imageView"
                            android:layout_width="250dp"
                            android:layout_height="250dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_star" />
                    </androidx.cardview.widget.CardView>

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <TextView
                    android:id="@+id/ingredient_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:text="Ingredient"
                    android:textColor="@color/colorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/nutrition_layout" />

                <ListView
                    android:id="@+id/recipe_steps_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_3x"
                    android:layout_marginTop="@dimen/margin_3x"
                    android:layout_marginEnd="@dimen/margin_3x"
                    android:layout_marginBottom="@dimen/margin_10x"
                    android:divider="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ingredient_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/start_cook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_5x"
            android:background="@drawable/bg_primary_raius_top"
            android:drawableStart="@drawable/ic_restaurant"
            android:drawablePadding="@dimen/margin_3x"
            android:padding="@dimen/margin_3x"
            android:text="Start Cooking"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="@color/white" />

        <ProgressBar
            android:id="@+id/progressBar3"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_4x"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>