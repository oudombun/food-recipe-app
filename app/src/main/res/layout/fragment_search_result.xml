<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:paddingHorizontal="16dp"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/toolbarBackResult"
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:src="@drawable/baseline_arrow_back_ios_new_24" />

        <com.oudombun.chelfy.util.StringInputView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            app:viewImeOptions="actionSearch"
            app:hint="@string/search"
            app:startIcon="@drawable/ic_search" />

        <ImageView
            android:id="@+id/searchButtonFilter"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_filter" />

    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/searchQueryContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_primary_raius_top"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margin_3x"
                android:paddingVertical="@dimen/margin_2x">

                <TextView
                    android:layout_marginEnd="@dimen/margin_2x"
                    android:id="@+id/txtMealType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Query"
                    android:textColor="@color/white" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_primary_raius_top"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/margin_3x"
                android:paddingVertical="@dimen/margin_2x">

                <TextView
                    android:layout_marginEnd="@dimen/margin_2x"
                    android:id="@+id/txtDietType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Query"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <com.cooltechworks.views.shimmer.ShimmerRecyclerView
        android:id="@+id/shimmer_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="10dp"
        android:paddingTop="10dp"
        app:shimmer_demo_layout="@layout/placeholder_search_layout"
        app:shimmer_demo_layout_manager_type="grid" />
</LinearLayout>
