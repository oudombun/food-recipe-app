<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="5dp"
    android:background="@drawable/bg_primary_raius_top"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/margin_3x"
    android:paddingVertical="@dimen/margin_2x">

    <TextView
        android:layout_marginEnd="@dimen/margin_2x"
        android:id="@+id/queryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Query"
        android:textColor="@color/white" />
    <TextView
        android:background="@drawable/bg_round_grey_raius"
        android:id="@+id/removeQueryButton"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:textAlignment="center"
        android:text="x"
        android:textColor="@color/black" />
</LinearLayout>